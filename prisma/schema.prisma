generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?       @map("email_verified")
  image            String?
  passwordHash     String?         @map("password_hash")
  role             Role            @default(USER)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  address          String?
  city             String?
  firstName        String?         @map("first_name")
  lastName         String?         @map("last_name")
  phone            String?
  phoneCountryCode String?         @map("phone_country_code")
  countryCode      String?         @map("country_code")
  postalCode       String?         @map("postal_code")
  accounts         Account[]
  cart             Cart?
  orders           Order[]
  paymentMethods   PaymentMethod[]
  payments         Payment[]
  reviews          Review[]
  sessions         Session[]
  supportReplies   SupportReply[]
  supportTickets   SupportTicket[]
  sellerProducts   Product[]       @relation("ProductSeller")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Product {
  id               Int                   @id @default(autoincrement())
  name             String
  category         String
  price            Decimal               @db.Decimal(12, 2)
  stock            Int
  createdAt        DateTime              @default(now())
  imageUrl         String?
  brand            String?
  description      String?
  discountPrice    Decimal?              @map("discount_price") @db.Decimal(12, 2)
  isActive         Boolean               @default(true) @map("is_active")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  scientificName   String?               @map("scientific_name")
  lightRequirement String?               @map("light_requirement")
  watering         String?
  careLevel        String?               @map("care_level")
  environment      String?
  plantSize        String?               @map("plant_size")
  petSafe          Boolean?              @map("pet_safe")
  bloomSeason      String?               @map("bloom_season")
  sellerId         String?               @map("seller_id")
  approvalStatus   ProductApprovalStatus @default(APPROVED) @map("approval_status")
  rejectionReason  String?               @map("rejection_reason")
  seller           User?                 @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]

  @@index([sellerId])
  @@index([approvalStatus])
  @@map("products")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  userId    String   @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

model Order {
  id     String      @id @default(cuid())
  userId String      @map("user_id")
  status OrderStatus @default(PENDING)
  total  Decimal     @db.Decimal(12, 2)

  shippingFirstName        String? @map("shipping_first_name")
  shippingLastName         String? @map("shipping_last_name")
  shippingPhoneCountryCode String? @map("shipping_phone_country_code")
  shippingPhone            String? @map("shipping_phone")
  shippingCountryCode      String? @map("shipping_country_code")
  shippingCity             String? @map("shipping_city")
  shippingPostalCode       String? @map("shipping_postal_code")
  shippingAddress          String? @map("shipping_address")

  shippingCarrier        String? @map("shipping_carrier")
  shippingTrackingNumber String? @map("shipping_tracking_number")
  shippingTrackingUrl    String? @map("shipping_tracking_url")

  deliveredAt DateTime? @map("delivered_at")

  requestType      OrderRequestType?
  requestStatus    OrderRequestStatus?
  requestReason    String?
  requestCreatedAt DateTime?           @map("request_created_at")

  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  items     OrderItem[]
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([userId])
  @@index([requestStatus])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  subject   String
  category  String
  message   String
  status    SupportStatus  @default(OPEN)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  replies   SupportReply[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportReply {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  adminId   String        @map("admin_id")
  message   String
  createdAt DateTime      @default(now()) @map("created_at")
  admin     User          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([adminId])
  @@map("support_replies")
}

model PaymentMethod {
  id                  String          @id @default(cuid())
  userId              String          @map("user_id")
  cardHolder          String          @map("card_holder")
  cardBrand           String          @map("card_brand")
  last4               String          @map("last4")
  expiryMonth         Int             @map("expiry_month")
  expiryYear          Int             @map("expiry_year")
  isDefault           Boolean         @default(false) @map("is_default")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  provider            PaymentProvider @default(IYZICO)
  providerCardToken   String?         @map("provider_card_token")
  providerCardUserKey String?         @map("provider_card_user_key")
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments            Payment[]

  @@index([userId])
  @@index([providerCardUserKey])
  @@map("payment_methods")
}

model Payment {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  orderId           String?         @map("order_id")
  paymentMethodId   String?         @map("payment_method_id")
  provider          PaymentProvider @default(IYZICO)
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("TRY")
  checkoutType      CheckoutType    @default(CART) @map("checkout_type")
  cartId            String?         @map("cart_id")
  conversationId    String          @unique @map("conversation_id")
  providerPaymentId String?         @map("provider_payment_id")
  providerToken     String?         @map("provider_token")
  errorCode         String?         @map("error_code")
  errorMessage      String?         @map("error_message")
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  order             Order?          @relation(fields: [orderId], references: [id])
  paymentMethod     PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([providerPaymentId])
  @@index([checkoutType])
  @@index([cartId])
  @@map("payments")
}

enum Role {
  USER
  DEALER
  ADMIN
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderRequestType {
  CANCELLATION
  RETURN
}

enum OrderRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  IYZICO
}

enum CheckoutType {
  CART
  BUY_NOW
}
