generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  category      String
  price         Float
  compatibility String
  stock         Int
  imageUrl      String?
  createdAt     DateTime @default(now())
}